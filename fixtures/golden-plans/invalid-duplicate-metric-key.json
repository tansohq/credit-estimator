{
  "name": "duplicate metric keys are rejected",
  "schemaVersion": "1.0",
  "methodologyVersion": "1.0",
  "input": {
    "schemaVersion": "1.0",
    "methodologyVersion": "1.0",
    "period": {
      "startDate": "2026-04-01",
      "endDate": "2026-05-01"
    },
    "metricEstimates": [
      { "key": "api-calls", "estimatedUnits": "100", "creditsPerUnit": "1" },
      { "key": "api-calls", "estimatedUnits": "200", "creditsPerUnit": "2" }
    ],
    "scenarios": [
      { "key": "low", "burnMultiplier": "0.5" },
      { "key": "base", "burnMultiplier": "1" },
      { "key": "high", "burnMultiplier": "1.5" }
    ]
  },
  "expectedError": {
    "schemaVersion": "1.0",
    "methodologyVersion": "1.0",
    "code": "INVALID_INPUT",
    "issues": [
      {
        "code": "DUPLICATE_METRIC_KEY",
        "path": "input.metricEstimates[1].key",
        "message": "metricEstimates contains duplicate key api-calls"
      }
    ]
  }
}
