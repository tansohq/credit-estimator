{
  "name": "plan allocation applies the explicit global buffer",
  "schemaVersion": "1.0",
  "methodologyVersion": "1.0",
  "modelVersion": "golden.plan-allocation.v1",
  "input": {
    "schemaVersion": "1.0",
    "methodologyVersion": "1.0",
    "modelVersion": "golden.plan-allocation.v1",
    "assumptions": {
      "currency": "USD",
      "realizedPricePerCredit": 0.01,
      "targetGrossMargin": 0.7,
      "targetValueCapture": 0.05,
      "maximumValueCapture": 0.1,
      "creditIncrement": 1,
      "planAllocationBuffer": 0.25
    },
    "metrics": [
      {
        "metricKey": "agent.plan_example",
        "monthlyVolume": 1000,
        "unitCost": 0.003,
        "confidenceAdjustedValue": 0.4,
        "creditsPerUnitOverride": 2
      }
    ],
    "scenarios": [
      {
        "key": "low",
        "volumeMultiplier": 0.7,
        "costMultiplier": 1,
        "providerPriceMultiplier": 1
      },
      {
        "key": "base",
        "volumeMultiplier": 1,
        "costMultiplier": 1,
        "providerPriceMultiplier": 1
      },
      {
        "key": "high",
        "volumeMultiplier": 1.4,
        "costMultiplier": 1,
        "providerPriceMultiplier": 1
      }
    ],
    "plans": [
      {
        "planKey": "pro",
        "allocationRoundingIncrement": 1
      }
    ]
  },
  "expected": {
    "schemaVersion": "1.0",
    "methodologyVersion": "1.0",
    "modelVersion": "golden.plan-allocation.v1",
    "plans": [
      {
        "planKey": "pro",
        "baseMonthlyCredits": 2000,
        "bufferedMonthlyCredits": 2500,
        "recommendedMonthlyCredits": 2500,
        "baseUtilization": 0.8,
        "highScenarioUtilization": 1.12,
        "expectedUnusedCredits": 500,
        "highScenarioCreditShortfall": 300,
        "highScenarioRequiresTopUp": true
      }
    ]
  }
}
