{
  "name": "observed and projected results preserve an ordered calculation trace",
  "schemaVersion": "1.0",
  "methodologyVersion": "1.0",
  "input": {
    "schemaVersion": "1.0",
    "methodologyVersion": "1.0",
    "asOf": "2026-01-04",
    "period": {
      "startDate": "2026-01-01",
      "endDate": "2026-01-08",
      "allocation": "320",
      "lowBalanceThreshold": "20"
    },
    "lookbackDays": 2,
    "dailyUsage": [
      { "date": "2026-01-01", "creditsUsed": "10" },
      { "date": "2026-01-02", "creditsUsed": "20" },
      { "date": "2026-01-03", "creditsUsed": "30" }
    ],
    "balance": {
      "current": "200",
      "schedule": []
    },
    "scenarios": [
      { "key": "low", "burnMultiplier": "0.5" },
      { "key": "base", "burnMultiplier": "1" },
      { "key": "high", "burnMultiplier": "1.5" }
    ]
  },
  "expected": {
    "schemaVersion": "1.0",
    "methodologyVersion": "1.0",
    "daysRemaining": 4,
    "creditsUsedToDate": "60",
    "baselineDailyBurn": "25",
    "observedPoints": [
      { "date": "2026-01-01", "creditsUsed": "10", "cumulativeCreditsUsed": "10" },
      { "date": "2026-01-02", "creditsUsed": "20", "cumulativeCreditsUsed": "30" },
      { "date": "2026-01-03", "creditsUsed": "30", "cumulativeCreditsUsed": "60" }
    ],
    "scenarios": [
      {
        "key": "low",
        "dailyBurn": "12.5",
        "projectedCreditsUsed": "50",
        "projectedPeriodConsumption": "110",
        "utilization": "0.34375",
        "endingBalance": "150",
        "depletionDate": null,
        "shortfall": "0",
        "status": "ON_TRACK"
      },
      {
        "key": "base",
        "dailyBurn": "25",
        "projectedCreditsUsed": "100",
        "projectedPeriodConsumption": "160",
        "utilization": "0.5",
        "endingBalance": "100",
        "depletionDate": null,
        "shortfall": "0",
        "status": "ON_TRACK",
        "points": [
          { "date": "2026-01-04", "startBalance": "200", "balanceDelta": "0", "creditsUsed": "25", "endingBalance": "175" },
          { "date": "2026-01-05", "startBalance": "175", "balanceDelta": "0", "creditsUsed": "25", "endingBalance": "150" },
          { "date": "2026-01-06", "startBalance": "150", "balanceDelta": "0", "creditsUsed": "25", "endingBalance": "125" },
          { "date": "2026-01-07", "startBalance": "125", "balanceDelta": "0", "creditsUsed": "25", "endingBalance": "100" }
        ]
      },
      {
        "key": "high",
        "dailyBurn": "37.5",
        "projectedCreditsUsed": "150",
        "projectedPeriodConsumption": "210",
        "utilization": "0.65625",
        "endingBalance": "50",
        "depletionDate": null,
        "shortfall": "0",
        "status": "ON_TRACK"
      }
    ],
    "calculationTrace": {
      "sourceInputs": [
        { "path": "input.asOf", "value": "2026-01-04" },
        { "path": "input.period.startDate", "value": "2026-01-01" },
        { "path": "input.period.endDate", "value": "2026-01-08" },
        { "path": "input.period.allocation", "value": "320" },
        { "path": "input.period.lowBalanceThreshold", "value": "20" },
        { "path": "input.lookbackDays", "value": 2 },
        { "path": "input.balance.current", "value": "200" },
        { "path": "input.scenarios[1].burnMultiplier", "value": "1" }
      ],
      "steps": [
        {
          "key": "observedCumulativeCreditsUsed",
          "formula": "cumulative[n] = cumulative[n - 1] + creditsUsed[n]",
          "operands": { "dailyCreditsUsed": ["10", "20", "30"] },
          "result": ["10", "30", "60"]
        },
        {
          "key": "creditsUsedToDate",
          "formula": "sum(dailyUsage[*].creditsUsed)",
          "operands": { "dailyCreditsUsed": ["10", "20", "30"] },
          "result": "60"
        },
        {
          "key": "baselineDailyBurn",
          "formula": "sum(lookbackCreditsUsed) / lookbackDays",
          "operands": { "lookbackCreditsUsed": ["20", "30"], "lookbackDays": 2 },
          "result": "25"
        },
        {
          "key": "daysRemaining",
          "formula": "calendar_days_in_[asOf,period.endDate)",
          "operands": { "asOf": "2026-01-04", "periodEndDate": "2026-01-08" },
          "result": 4
        },
        {
          "key": "base.dailyBurn",
          "formula": "baselineDailyBurn * burnMultiplier",
          "operands": { "baselineDailyBurn": "25", "burnMultiplier": "1" },
          "result": "25"
        },
        {
          "key": "base.projectedCreditsUsed",
          "formula": "dailyBurn * daysRemaining",
          "operands": { "dailyBurn": "25", "daysRemaining": 4 },
          "result": "100"
        },
        {
          "key": "base.projectedPeriodConsumption",
          "formula": "creditsUsedToDate + projectedCreditsUsed",
          "operands": { "creditsUsedToDate": "60", "projectedCreditsUsed": "100" },
          "result": "160"
        },
        {
          "key": "base.utilization",
          "formula": "projectedPeriodConsumption / periodAllocation",
          "operands": { "projectedPeriodConsumption": "160", "periodAllocation": "320" },
          "result": "0.5"
        },
        {
          "key": "base.points",
          "formula": "endingBalance = startBalance + balanceDelta - creditsUsed",
          "operands": { "initialBalance": "200", "dailyBurn": "25", "scheduledDeltas": [] },
          "result": [
            { "date": "2026-01-04", "startBalance": "200", "balanceDelta": "0", "creditsUsed": "25", "endingBalance": "175" },
            { "date": "2026-01-05", "startBalance": "175", "balanceDelta": "0", "creditsUsed": "25", "endingBalance": "150" },
            { "date": "2026-01-06", "startBalance": "150", "balanceDelta": "0", "creditsUsed": "25", "endingBalance": "125" },
            { "date": "2026-01-07", "startBalance": "125", "balanceDelta": "0", "creditsUsed": "25", "endingBalance": "100" }
          ]
        },
        {
          "key": "base.depletionDate",
          "formula": "first date where endingBalance <= 0",
          "operands": { "endingBalances": ["175", "150", "125", "100"] },
          "result": null
        },
        {
          "key": "base.shortfall",
          "formula": "max(0, -endingBalance)",
          "operands": { "endingBalance": "100" },
          "result": "0"
        },
        {
          "key": "base.status",
          "formula": "status_from_depletion_date_ending_balance_and_threshold",
          "operands": { "depletionDate": null, "endingBalance": "100", "lowBalanceThreshold": "20" },
          "result": "ON_TRACK"
        }
      ]
    },
    "warnings": []
  }
}
