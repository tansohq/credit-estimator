{
  "name": "identical inputs produce identical outputs",
  "schemaVersion": "1.0",
  "methodologyVersion": "1.0",
  "modelVersion": "golden.deterministic.v1",
  "input": {
    "schemaVersion": "1.0",
    "methodologyVersion": "1.0",
    "modelVersion": "golden.deterministic.v1",
    "assumptions": {
      "currency": "USD",
      "realizedPricePerCredit": 0.01,
      "targetGrossMargin": 0.7,
      "targetValueCapture": 0.05,
      "maximumValueCapture": 0.1,
      "creditIncrement": 1,
      "planAllocationBuffer": 0.2
    },
    "metrics": [
      {
        "metricKey": "agent.extract",
        "monthlyVolume": 500,
        "unitCost": 0.004,
        "confidenceAdjustedValue": 0.4
      }
    ]
  },
  "execution": {
    "repeatCount": 2
  },
  "expected": {
    "schemaVersion": "1.0",
    "methodologyVersion": "1.0",
    "modelVersion": "golden.deterministic.v1",
    "assertions": {
      "outputsDeepEqual": true,
      "timestampsExcludedFromDeterministicPayload": true,
      "randomValuesUsed": false
    }
  }
}
