    },
    "scenarios": [
      { "key": "low", "burnMultiplier": "0.5" },
      { "key": "base", "burnMultiplier": "1" },
      { "key": "high", "burnMultiplier": "1.5" }
    ]
  },
  "expectedError": {
    "schemaVersion": "1.0",
