{
  "name": "@tansohq/credit-forecast-core",
  "version": "0.1.0",
  "description": "Deterministic provider-neutral credit usage forecasting engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tansohq/credit-estimator.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/tansohq/credit-estimator#readme",
  "bugs": {
    "url": "https://github.com/tansohq/credit-estimator/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tansohq/credit-forecast-schema": "workspace:*",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
